<% layout("layouts/boilerplate.ejs") %>

<main class="landing-page">
  <section class="landing-hero">
    <div class="landing-copy">
      <p class="landing-eyebrow"><i class="fa-solid fa-sparkles"></i> Learn. Share. Grow.</p>
      <h1>Your skills deserve a community.</h1>
      <p class="landing-lede">
        SkillNest is a space for students to share what they are building,
        learn from one another, and make progress together.
      </p>
      <div class="landing-actions">
        <a class="landing-primary" href="/auth/register">Create your account <i class="fa-solid fa-arrow-right"></i></a>
        <a class="landing-secondary" href="/auth/login">Log in</a>
      </div>
      <p class="landing-note">Already a member? <a href="/auth/login">Welcome back.</a></p>
    </div>

    <div class="landing-preview" aria-hidden="true">
      <div class="preview-top"><span></span><span></span><span></span></div>
      <div class="preview-profile">
        <div class="preview-avatar">S</div>
        <div><strong>SkillNest community</strong><small>Building together</small></div>
      </div>
      <div class="preview-lines"><i></i><i></i><i></i></div>
      <div class="preview-image"><i class="fa-solid fa-code"></i></div>
      <div class="preview-reactions"><span><i class="fa-regular fa-heart"></i> 24</span><span><i class="fa-regular fa-comment"></i> 8</span></div>
    </div>
  </section>

  <section class="landing-features" aria-label="SkillNest features">
    <article><i class="fa-solid fa-pen-to-square"></i><h2>Share your work</h2><p>Post projects, ideas, and milestones as you learn.</p></article>
    <article><i class="fa-solid fa-people-group"></i><h2>Find your people</h2><p>Follow classmates and encourage their progress.</p></article>
    <article><i class="fa-solid fa-lightbulb"></i><h2>Keep growing</h2><p>Discover practical inspiration from your community.</p></article>
  </section>
</main>
